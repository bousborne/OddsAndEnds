# ============================================
# Disk Management Aliases (macOS)
# ============================================
lsblk() { echo "→ diskutil list"; diskutil list; }
disks() { echo "→ diskutil list"; diskutil list; }
lsext() { echo "→ diskutil list external"; diskutil list external; }
dinfo() { echo "→ diskutil info $@"; diskutil info "$@"; }
duuid() { echo "→ diskutil info $@ | grep UUID"; diskutil info "$@" | grep "Volume UUID"; }
dfs() { echo "→ diskutil info $@ | grep File System"; diskutil info "$@" | grep "File System"; }

# Full blkid equivalent - shows UUID, TYPE, and more
blkid() {
    if [[ -z "$1" ]]; then
        echo "→ Show UUID and FS for all disks"
        for disk in $(diskutil list | grep "^/dev/disk" | awk '{print $1}'); do
            echo "=== $disk ==="
            diskutil info "$disk" 2>/dev/null | grep -E "Device Node|Volume Name|Volume UUID|File System Personality|Mount Point" | sed 's/^/  /'
            echo
        done
    else
        echo "→ diskutil info $@ | grep UUID, FS, Mount"
        diskutil info "$@" | grep -E "Device Node|Volume Name|Volume UUID|File System Personality|Mount Point"
    fi
}

# blkid alternatives
blkid-list() {
    echo "→ List all block devices with UUID and FS type"
    printf "%-15s %-40s %-15s %-20s\n" "DEVICE" "UUID" "TYPE" "LABEL"
    printf "%-15s %-40s %-15s %-20s\n" "======" "====" "====" "====="
    for disk in $(diskutil list | grep "^/dev/disk" | awk '{print $1}'); do
        local uuid=$(diskutil info "$disk" 2>/dev/null | grep "Volume UUID" | awk '{print $3}')
        local fstype=$(diskutil info "$disk" 2>/dev/null | grep "File System Personality" | awk '{print $4}')
        local label=$(diskutil info "$disk" 2>/dev/null | grep "Volume Name" | awk '{$1=$2=""; print $0}' | xargs)
        [[ -n "$uuid" ]] && printf "%-15s %-40s %-15s %-20s\n" "$disk" "$uuid" "$fstype" "$label"
    done
}

# Show all UUIDs (comprehensive blkid replacement)
uuids() {
    echo "→ Show all UUIDs for all disks"
    for disk in $(diskutil list | grep "^/dev/disk" | awk '{print $1}'); do
        echo "=== $disk ==="
        diskutil info "$disk" 2>/dev/null | grep -E "Volume Name|Volume UUID|File System|Mount Point"
        echo
    done
}

mounts() { echo "→ mount | grep /dev/disk"; mount | grep /dev/disk; }
mounted() { echo "→ df -h | grep /dev/disk"; df -h | grep /dev/disk; }
dunmount() { echo "→ diskutil unmount $@"; diskutil unmount "$@"; }
dmount() { echo "→ diskutil mount $@"; diskutil mount "$@"; }
eject() { echo "→ diskutil eject $@"; diskutil eject "$@"; }

