# Prompt Configuration
# ============================================
# Set prompt with title, green user@host, blue directory
PS1='\[\e[32m\]\u\[\e[35m\]:\[\e[34m\]\w \[\e[0m\]$(if [[ $? == 0 ]]; then echo "\[\e[32m\]\$\[\e[0m\]"; else echo "\[\e[31m\]\$\[\e[0m\]"; fi) '

# Set terminal title
PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'

# ============================================
# SSH Agent Configuration
# ============================================
if ! pgrep -u "$USER" ssh-agent > /dev/null; then
    eval "$(ssh-agent -s)" &> /dev/null
fi

# Add private keys to ssh user agent (silently)
ssh-add ~/.ssh/id_rsa ~/.ssh/id_ed25519 ~/.ssh/id_rsa_zfssa ~/.ssh/id_ed25519_github ~/.ssh/id_ed25519_opensores ~/.ssh/id_ed25519_oracle_oci_gitlab ~/.ssh/id_ed25519_oracle_oci_gitlab.pub &> /dev/null

# Check if keys are loaded
ssh-add -l >/dev/null 2>&1
if [ $? -eq 0 ]; then
    echo "SSH keys already loaded."
else
    echo "SSH keys added."
fi

