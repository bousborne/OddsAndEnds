# ============================================
# ZFS Storage Appliance SSH Function
# ============================================
# WARNING: This function contains a hardcoded password (l1admin1)
# Consider using proper SSH key authentication instead
ssh_auto() {
    local hosts=("chutoro" "chutoro-sp" "badenov" "badenov-sp" "bullwinkle" "bullwinkle-sp" "nori" "nori-sp")
    local target=$1
    local ssh_key_path="$HOME/.ssh/id_rsa_zfssa"
    local ssh_key_base64

    # Check if the input matches one of the predefined hostnames
    if [[ ! " ${hosts[@]} " =~ " ${target} " ]]; then
        echo "Unknown host: ${target}"
        return 1
    fi

    echo "Attempting SSH to ${target} without password prompt..."

    # Use BatchMode to check if SSH can authenticate without a password
    ssh -o BatchMode=yes "${target}" "exit" &>/dev/null
    if [[ $? -eq 0 ]]; then
        echo "SSH login successful."
        ssh -o PreferredAuthentications=publickey -o PasswordAuthentication=no "${target}"
        return 0
    else
        echo "SSH key might not be added or password is required."
    fi

    # Extract just the base64 portion of the key
    ssh_key_base64=$(awk '{print $2}' "${ssh_key_path}.pub")
    echo "key = ${ssh_key_base64}"

    echo "Adding SSH key to ZFS Storage Appliance CLI..."
    sshpass -p l1admin1 ssh "root@${target}" -t <<EOF
        script
            function create_ssh_key(type, key, comment) {
                run('configuration users select root preferences keys');
                run('create');
                set('type', type);
                set('key', key);
                set('comment', comment);
                run('commit');
            }
            create_ssh_key('RSA', '${ssh_key_base64}', '$(whoami)@$(hostname)');
        .
EOF

    echo "SSH key added successfully. Attempting final SSH connection..."
    ssh -o PreferredAuthentications=publickey -o PasswordAuthentication=no "root@${target}"
}

# Create aliases for each hostname
for host in chutoro chutoro-sp badenov badenov-sp bullwinkle bullwinkle-sp nori nori-sp; do
    alias "$host"="ssh_auto $host"
done

